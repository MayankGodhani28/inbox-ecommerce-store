{
  "name": "inbox-ecommerce-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "server:dev": "tsx watch server/index.ts",
    "server:typecheck": "tsc -p tsconfig.server.json",
    "server:build": "esbuild server/index.ts --bundle --platform=node --format=esm --outdir=dist/server --packages=external",
    "server:start": "node dist/server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx server/db/seed.ts",
    "db:backup": "tsx server/scripts/backupAndRestore.ts",
    "admin:bootstrap": "tsx server/db/bootstrapAdmin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "vitest run src/tests/integration",
    "test:component": "vitest run src/tests/component",
    "test:security": "vitest run src/tests/security",
    "test:regression": "vitest run src/tests/regression",
    "test:e2e": "vitest run src/tests/e2e",
    "test:all": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "load:normal": "npx artillery run load-tests/01-normal-load.yml",
    "load:stress": "npx artillery run load-tests/02-stress-test.yml",
    "load:spike": "npx artillery run load-tests/03-spike-test.yml",
    "load:soak": "npx artillery run load-tests/04-soak-test.yml",
    "load:endpoints": "npx artillery run load-tests/05-api-endpoints.yml",
    "load:all": "npx tsx load-tests/run-load-tests.ts --all",
    "load:report": "npx artillery report",
    "test:codeant": "node --experimental-strip-types --test tests/codeant-security.test.mjs"
  },
  "prisma": {
    "seed": "tsx server/db/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@stripe/stripe-js": "^10.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^23.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "artillery": "^2.0.34",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "jsdom": "^27.0.1",
    "msw": "^2.15.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "csv-parse": "^7.0.2"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
