{
  "framework": "vite",
  "regions": ["bom1"],
  "installCommand": "npm ci && npm run prisma:generate && npm run vercel:api",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/store.mjs": {
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/store"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/sell/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/super-admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/login/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/products/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/cart/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/checkout/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/profile/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/orders/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/order-tracking/:path*",
      "destination": "/index.html"
    }
  ]
}
